# development | production
APP_ENV=development

# Public site URL (no trailing slash). Used for auth email redirects.
APP_BASE_URL=http://127.0.0.1:8000

# Local default: leave empty to use SQLite ./health_tracker.db
# Production: required Postgres URL (postgresql://...)
DATABASE_URL=

# Required in production. Used for signing cookies/CSRF.
SECRET_KEY=change-me

# supabase (production) | local (development/testing only)
AUTH_MODE=local

# Supabase project settings (required when AUTH_MODE=supabase or in production)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=meal-photos

# Cookie Secure flag. Leave empty to auto: true in production, false in development.
COOKIE_SECURE=

# Comma-separated hosts for TrustedHostMiddleware
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional OpenAI vision estimation
OPENAI_API_KEY=
OPENAI_FOOD_MODEL=gpt-4.1-mini

# Optional tuning
SESSION_TTL_DAYS=14
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=16777216
